# Kopiraj u .env (koji je u .gitignore) i popuni
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/infostone
JWT_SECRET=promeni-me
JWT_EXPIRES_IN=7d

# FastAPI (Gemma servis)
AI_SERVICE_URL=http://127.0.0.1:8000
# true = aiClient vraca lazne odgovore, ne zove FastAPI (dok AI servis nije spreman)
MOCK_AI=true

UPLOAD_DIR=../uploads
PUBLIC_BASE_URL=http://localhost:3000
# Origin-i koji smeju da zovu API iz browsera (InfoStone dashboard)
CORS_ORIGINS=http://localhost:4200
